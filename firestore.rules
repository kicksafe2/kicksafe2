rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 본인 데이터만 읽기/쓰기 가능
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // 회원가입 아이디 색인: 아이디를 정확히 알 때만 1건 조회 가능(목록 조회 불가),
    // 가입 시 본인 uid로 한 번만 생성 가능, 수정/삭제 불가
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'email'])
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 주행 기록(세션). 문서를 새로 만들 때는 resource 가 비어 있으므로
    // 생성은 request.resource(보내는 값)로, 읽기/수정/삭제는 resource(저장된 값)로 검사한다.
    match /sessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // 센서 원시값 / 점수 이벤트: 문서(sessionId) 아래 하위 컬렉션에 쌓이는데,
    // 상위 match 는 하위 컬렉션에 적용되지 않으므로 따로 열어준다.
    match /imuLogs/{sessionId}/logs/{logId} {
      allow read, write: if request.auth != null;
    }
    match /scoreEvents/{sessionId}/events/{eventId} {
      allow read, write: if request.auth != null;
    }
  }
}
